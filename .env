# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./banking.db
TEST_DATABASE_URL=sqlite+aiosqlite:///./banking_test.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Configuration
APP_NAME="Agent Banking Platform"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# File Storage
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE=10485760  # 10MB

# External APIs
ECOCASH_API_URL=https://api.ecocash.co.zw
AIRTEL_MONEY_API_URL=https://api.airtel.co.zw

# Monitoring
PROMETHEUS_PORT=8001
ENABLE_METRICS=true